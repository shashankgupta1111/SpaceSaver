{
  "name": "SpaceSaver",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "build-apk": "cd android && ./gradlew app:assembleRelease",
    "build-debug": "cd android && ./gradlew app:assembleDebug",
    "build-release": "cd android && ./gradlew app:assembleRelease",
    "install-apk": "adb install -r -g android/app/build/outputs/apk/release/app-release.apk",
    "install-debug": "adb install -r -g android/app/build/outputs/apk/debug/app-debug.apk",
    "clean": "cd android && ./gradlew clean"
  },
  "dependencies": {
    "@react-native-camera-roll/camera-roll": "^7.8.0",
    "@react-native-community/slider": "^4.5.5",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@shopify/flash-list": "^1.7.1",
    "@tanstack/react-query": "^5.59.15",
    "date-fns": "^4.1.0",
    "lottie-react-native": "^7.1.0",
    "react": "19.0.0",
    "react-native": "0.79.7",
    "react-native-compressor": "^2.0.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-gifted-charts": "^1.4.31",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^3.1.0",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-permissions": "^4.1.5",
    "react-native-reanimated": "^3.19.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.11.1",
    "react-native-share": "^11.0.0",
    "react-native-svg": "^15.8.0",
    "react-native-vector-icons": "^10.2.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^18.0.0",
    "@react-native-community/cli-platform-android": "^18.0.0",
    "@react-native/babel-preset": "0.79.7",
    "@react-native/eslint-config": "0.79.7",
    "@react-native/metro-config": "0.79.7",
    "@react-native/typescript-config": "0.79.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "@types/react-native-fs": "^2.13.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.0",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "react-native"
  }
}
